---
// Placeholder not-found page. GitHub Pages serves a single root 404.html for
// every locale, so it uses the English dictionary. A terminal-style 404 is a
// separate change.
import BaseLayout from "../layouts/BaseLayout.astro";
import { localePath, t } from "../i18n";

const locale = "en";
---

<BaseLayout
  locale={locale}
  title={`${t(locale, "notFound.title")} — ${t(locale, "meta.title")}`}
  description={t(locale, "notFound.message")}
  pageEvent="not_found"
>
  <a class="skip-link" href="#main">
    {t(locale, "skipLink")}
  </a>
  <main id="main" class="not-found">
    <h1>{t(locale, "notFound.heading")}</h1>
    <p>{t(locale, "notFound.message")}</p>
    <p>
      <a href={localePath(locale)}>{t(locale, "notFound.backHome")}</a>
    </p>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    align-content: center;
    gap: var(--space-3);
    min-height: 100vh;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-5) var(--space-4);
  }

  h1 {
    font-family: var(--font-title);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
  }

  p {
    color: var(--text-muted);
  }
</style>

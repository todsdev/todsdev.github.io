---
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/global.css";
import plexMonoLatin400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import vt323Latin400 from "@fontsource/vt323/files/vt323-latin-400-normal.woff2?url";
import Footer from "../components/Footer.astro";
import { langCode, localePath, locales, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Page has the animated hero intro: gate it before first paint. */
  heroIntro?: boolean;
}

const { locale, title, description, heroIntro = false } = Astro.props;
const site = Astro.site ?? new URL("https://todsdev.github.io");
const alternates = locales.map((l) => ({
  hreflang: langCode[l],
  href: new URL(localePath(l), site).href,
}));
const xDefault = new URL(localePath("en"), site).href;
---

<html lang={langCode[locale]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head-start" />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
    {heroIntro && <script is:inline>
      // Hide the hero's final text before first paint when its intro will
      // play (motion allowed, no deep link to another section).
      // src/scripts/hero.ts takes over; the timeout is a safety net in case
      // that script never runs, so content is never stuck hidden.
      (function () {
        const root = document.documentElement;
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const hash = location.hash;
        if (reduce || (hash !== "" && hash !== "#hero")) return;
        root.classList.add("hero-pending");
        setTimeout(function () {
          root.classList.remove("hero-pending");
        }, 4000);
      })();
    </script>}
    <!-- Above-the-fold fonts (same files as the @font-face rules), fetched early so
         text never swaps fonts after first paint. -->
    <link
      rel="preload"
      href={plexMonoLatin400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={vt323Latin400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
  </head>
  <body>
    <slot />
    <Footer locale={locale} />
  </body>
</html>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Courses from "./Courses.astro";
import Experience from "./Experience.astro";
import Hero from "./Hero.astro";
import Projects from "./Projects.astro";
import Section from "./Section.astro";
import ScrollThread from "./ScrollThread.astro";
import Skills from "./Skills.astro";
import SiteNav from "./SiteNav.astro";
import Terminal from "./Terminal.astro";
import TerminalHint from "./TerminalHint.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { t, type Locale } from "../i18n";
import { getEntries, reportMissingTranslations } from "../lib/content";
import { renderedSections } from "../lib/sections";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await reportMissingTranslations(locale);
const [profile] = await getEntries("profile", locale);
if (!profile) {
  throw new Error("src/content/profile must contain one entry");
}
const sections = renderedSections(profile.courses.enabled);
const contentSections = sections.filter((id) => id !== "hero");
---

<BaseLayout
  locale={locale}
  title={t(locale, "meta.title")}
  description={t(
    locale,
    profile.courses.enabled ? "meta.description" : "meta.descriptionNoCourses",
  )}
  heroIntro
>
  {locale === "en" && <script is:inline slot="head-start">
    // Saved-language redirect for the unprefixed root only. Runs synchronously
    // in <head> before any stylesheet, so English is never painted first.
    // Keep the key in sync with PREFERRED_LOCALE_KEY in src/lib/storage-keys.ts.
    // Never consults the browser language.
    (function () {
      try {
        const saved = localStorage.getItem("preferred-locale");
        if (saved === "pt-br" || saved === "es") {
          document.documentElement.style.visibility = "hidden";
          setTimeout(function () {
            document.documentElement.style.visibility = "";
          }, 3000);
          location.replace("/" + saved + "/" + location.hash);
        }
      } catch {
        // Storage blocked: stay on English.
      }
    })();
  </script>}
  <a class="skip-link" href="#main">
    {t(locale, "skipLink")}
  </a>
  <SiteNav locale={locale} sections={sections}>
    <LanguageSwitcher slot="end" locale={locale} />
  </SiteNav>
  <main id="main" class="site-main">
    <ScrollThread />
    <Hero locale={locale} />
    {contentSections.map((id) =>
      id === "about" ? (
        <Section id={id} locale={locale}>
          <About locale={locale} />
        </Section>
      ) : id === "experience" ? (
        <Section id={id} locale={locale}>
          <Experience locale={locale} />
        </Section>
      ) : id === "projects" ? (
        <Section id={id} locale={locale}>
          <Projects locale={locale} />
        </Section>
      ) : id === "skills" ? (
        <Section id={id} locale={locale}>
          <Skills locale={locale} />
        </Section>
      ) : id === "courses" ? (
        <Section id={id} locale={locale}>
          <Courses locale={locale} />
        </Section>
      ) : id === "contact" ? (
        <Section id={id} locale={locale}>
          <Contact locale={locale} />
        </Section>
      ) : (
        <Section id={id} locale={locale} />
      ),
    )}
  </main>
  <Terminal locale={locale} />
  <TerminalHint slot="footer-hint" locale={locale} />
</BaseLayout>

<script>
  import "../scripts/reveal";
  import "../scripts/thread";
</script>

<style>
  .site-main {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--nav-height) var(--space-4) 0 var(--thread-gutter);
  }
</style>

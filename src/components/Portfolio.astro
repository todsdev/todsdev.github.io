---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "./Section.astro";
import SiteNav from "./SiteNav.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { t, type Locale } from "../i18n";
import { getEntries, reportMissingTranslations } from "../lib/content";
import { sectionIds } from "../lib/sections";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
await reportMissingTranslations(locale);
const [profile] = await getEntries("profile", locale);
if (!profile) throw new Error("src/content/profile must contain one entry");
const contentSections = sectionIds.filter((id) => id !== "hero");
---

<BaseLayout
  locale={locale}
  title={t(locale, "meta.title")}
  description={t(locale, "meta.description")}
>
  {locale === "en" && <script is:inline slot="head-start">
    // Saved-language redirect for the unprefixed root only. Runs synchronously
    // in <head> before any stylesheet, so English is never painted first.
    // Keep the key in sync with PREFERRED_LOCALE_KEY in src/scripts/locale.ts.
    // Never consults the browser language.
    (function () {
      try {
        var saved = localStorage.getItem("preferred-locale");
        if (saved === "pt-br" || saved === "es") {
          document.documentElement.style.visibility = "hidden";
          setTimeout(function () {
            document.documentElement.style.visibility = "";
          }, 3000);
          location.replace("/" + saved + "/" + location.hash);
        }
      } catch (e) {
        // Storage blocked: stay on English.
      }
    })();
  </script>}
  <a class="skip-link" href="#main">
    {t(locale, "skipLink")}
  </a>
  <SiteNav locale={locale}>
    <LanguageSwitcher slot="end" locale={locale} />
  </SiteNav>
  <main id="main" class="site-main">
    <Section id="hero" locale={locale} titleTag="p">
      <h1 class="hero__name">{profile.name}</h1>
    </Section>
    {contentSections.map((id) => (
      <Section id={id} locale={locale} />
    ))}
  </main>
</BaseLayout>

<script>
  import "../scripts/reveal";
</script>

<style>
  .site-main {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--nav-height) var(--space-4) 0 var(--thread-gutter);
  }

  .hero__name {
    font-family: var(--font-title);
    font-size: clamp(3rem, 2rem + 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1;
    color: var(--text);
    margin-top: var(--space-3);
  }
</style>

---
import { t, type Locale } from "../i18n";
import { eventAttrs } from "../lib/analytics";
import type { SectionId } from "../lib/sections";

interface Props {
  locale: Locale;
  sections: readonly SectionId[];
}

const { locale, sections } = Astro.props;
---

<header class="site-nav">
  <nav class="site-nav__sections" aria-label={t(locale, "nav.label")}>
    <ul class="site-nav__list" role="list">
      {sections.map((id) => (
        <li>
          <a
            class="site-nav__link"
            href={`#${id}`}
            data-nav-link={id}
            {...eventAttrs(locale, "nav_click", { section: id })}
          >
            {t(locale, `nav.${id}` as const)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="site-nav__end">
    <slot name="end" />
  </div>
</header>

<script>
  import "../scripts/nav";
</script>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--nav-height);
    padding-inline: var(--space-3);
    background: var(--bg);
    border-bottom: 1px solid var(--surface-2);
  }

  .site-nav__sections {
    flex: 1;
    min-width: 0;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav__sections::-webkit-scrollbar {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    height: 100%;
    width: max-content;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-1) 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--highlight);
  }

  .site-nav__link.is-active {
    color: var(--highlight);
  }

  /* The indicator ("> " prefix + block cursor) is rendered on every link but only
     visible on the active one, so its space is always reserved: changing the
     active link (on load, while scrolling) never moves or resizes the nav. */
  .site-nav__link::before {
    content: "> ";
    content: "> " / "";
    white-space: pre;
    visibility: hidden;
  }

  .site-nav__link::after {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.2em;
    background: var(--highlight);
    visibility: hidden;
  }

  .site-nav__link.is-active::before,
  .site-nav__link.is-active::after {
    visibility: visible;
  }

  /* Blinking block cursor; steady under reduced motion (global rule removes animations). */
  .site-nav__link.is-active::after {
    animation: cursor-blink 1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .site-nav__link:focus-visible {
    outline-offset: -2px;
  }

  /* Narrowest phones (< 360px): tighter spacing and a slightly smaller label so
     the longest active label ("> Experiência", "> Habilidades") fits the strip. */
  @media (max-width: 22.49rem) {
    .site-nav {
      gap: var(--space-2);
      padding-inline: var(--space-2);
    }

    .site-nav__link {
      font-size: 0.8125rem;
    }
  }

  .site-nav__end {
    flex: none;
    display: flex;
    align-items: center;
  }
</style>

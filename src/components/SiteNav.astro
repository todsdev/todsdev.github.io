---
import { t, type Locale } from "../i18n";
import { sectionIds } from "../lib/sections";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header class="site-nav">
  <nav class="site-nav__sections" aria-label={t(locale, "nav.label")}>
    <ul class="site-nav__list" role="list">
      {sectionIds.map((id) => (
        <li>
          <a class="site-nav__link" href={`#${id}`} data-nav-link={id}>
            {t(locale, `nav.${id}` as const)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="site-nav__end">
    <slot name="end" />
  </div>
</header>

<script>
  // Browsers only scroll a focused link into view when it is fully hidden; keep
  // partially clipped links in the horizontally scrolling list fully visible too.
  const list = document.querySelector<HTMLElement>(".site-nav__sections");
  list?.addEventListener("focusin", (event) => {
    const link = event.target as HTMLElement;
    const view = list.getBoundingClientRect();
    const box = link.getBoundingClientRect();
    if (box.left < view.left) list.scrollLeft -= view.left - box.left;
    else if (box.right > view.right) list.scrollLeft += box.right - view.right;
  });
</script>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--nav-height);
    padding-inline: var(--space-3);
    background: var(--bg);
    border-bottom: 1px solid var(--surface-2);
  }

  .site-nav__sections {
    flex: 1;
    min-width: 0;
    height: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav__sections::-webkit-scrollbar {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    height: 100%;
    width: max-content;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-2);
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--highlight);
  }

  .site-nav__link:focus-visible {
    outline-offset: -2px;
  }

  .site-nav__end {
    flex: none;
    display: flex;
    align-items: center;
  }
</style>

---
/**
 * Project cards (rendered inside <Section id="projects">), built entirely from the
 * projects collection: phone-framed first screenshot, ownership badge, description,
 * tech tags and terminal actions. Under the list, the ownership note is generated
 * from the contributor projects (src/lib/projects.ts).
 */
import { Picture } from "astro:assets";
import { t, type Locale } from "../i18n";
import { getEntries } from "../lib/content";
import {
  ownershipNotes,
  projectActions,
  sortProjects,
  type ActionKind,
} from "../lib/projects";
import TechTags from "./TechTags.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = sortProjects(await getEntries("projects", locale));
const notes = ownershipNotes(projects, locale, {
  one: t(locale, "projects.note.one"),
  other: t(locale, "projects.note.other"),
  through: t(locale, "projects.note.through"),
});
const newTab = t(locale, "projects.newTab");
const destination = (kind: ActionKind, title: string) =>
  t(locale, `projects.destination.${kind}`).replace("{title}", title);
---

<ul class="projects" role="list">
  {projects.map((project) => {
    const titleId = `project-${project.id}`;
    const shot = project.screenshots?.[0];
    const actions = projectActions(project);
    return (
      <li>
        <article
          class:list={["card", { "card--shot": shot }]}
          aria-labelledby={titleId}
        >
          {shot && (
            <figure class="card__phone">
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={["avif", "webp"]}
                widths={[160, 320, 480]}
                sizes="(min-width: 40rem) 9rem, 8rem"
                loading="lazy"
                decoding="async"
                class="card__shot"
              />
            </figure>
          )}
          <div class="card__body">
            <h3 id={titleId} class="card__title">
              {project.title}
            </h3>
            <p class="card__badge">
              {t(locale, `projects.ownership.${project.ownership}`)}
              {project.via &&
                ` · ${t(locale, "projects.via").replace("{name}", project.via)}`}
            </p>
            <p class="card__desc">{project.description}</p>
            <TechTags items={project.tech} />
            {project.status === "building" && (
              <p class="card__status">
                [{t(locale, "projects.building")}{" "}
                <span aria-hidden="true">▓▓▓░░░</span>]
              </p>
            )}
            {actions.length > 0 && (
              <ul class="card__actions" role="list">
                {actions.map((action) => (
                  <li>
                    {/* No whitespace between the command and its hidden destination: it would read "play-store ,". */}
                    {/* prettier-ignore */}
                    <a class="card__action" href={action.href} target="_blank" rel="noopener"><span aria-hidden="true">$ </span>{action.command}<span class="visually-hidden">{`, ${destination(action.kind, project.title)} (${newTab})`}</span></a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      </li>
    );
  })}
</ul>
{notes.length > 0 && <p class="projects__note">{notes.join(" ")}</p>}

<style>
  .projects {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  /* Frame beside the text from 40rem; stacked above it on narrow screens. */
  .card--shot {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  @media (max-width: 39.99rem) {
    .card--shot {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }

    .card__phone {
      width: 8rem;
    }
  }

  /* Flat phone: gray border and an even bezel, no notch, buttons or logo. */
  .card__phone {
    margin: 0;
    padding: 4px;
    border: 2px solid var(--surface-2);
    border-radius: 1.25rem;
    background: var(--surface);
  }

  /* The 9:19.5 box reserves the screen's space before the lazy image loads. */
  .card__phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 19.5;
    border-radius: 0.875rem;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 150ms ease-out;
  }

  /* Color while the card is hovered or anything in it has focus (like the flags). */
  .card:hover .card__phone :global(img),
  .card:focus-within .card__phone :global(img) {
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card__phone :global(img) {
      transition: none;
    }
  }

  /* Regular weight on purpose, as in the experience timeline. */
  .card__title {
    color: var(--text);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
  }

  /* Terminal token like the tech tags, outlined in the muted tone: metadata, not tech. */
  .card__badge {
    display: inline-block;
    margin-top: var(--space-1);
    padding: 0 0.4em;
    border: 1px solid var(--text-muted);
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .card__desc {
    max-width: var(--measure);
    margin-top: var(--space-3);
    color: var(--text);
    line-height: 1.7;
  }

  .card__status {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .card__action {
    display: inline-block;
    min-height: 1.5rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5rem;
    text-decoration: none;
  }

  .card__action:hover,
  .card__action:focus-visible {
    color: var(--highlight);
  }

  .projects__note {
    max-width: var(--measure);
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>

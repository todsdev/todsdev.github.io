---
import { t, type Locale } from "../i18n";
import type { SectionId } from "../lib/sections";

interface Props {
  id: Exclude<SectionId, "hero">;
  locale: Locale;
}

const { id, locale } = Astro.props;
const titleId = `${id}-title`;
const prompt = t(locale, `prompt.${id}` as const);
---

<section id={id} class="section" data-reveal aria-labelledby={titleId}>
  <h2 id={titleId} class="section__title">
    <span class="section__prompt" aria-hidden="true">
      ${" "}
    </span>
    {prompt}
  </h2>
  <slot />
</section>

<style>
  .section {
    min-height: 60vh;
    padding-block: var(--space-6);
    scroll-margin-top: var(--nav-height);
  }

  .section__title {
    font-family: var(--font-title);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text);
  }

  .section__prompt {
    color: var(--text-muted);
  }
</style>

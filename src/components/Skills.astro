---
/**
 * Skills (rendered inside <Section id="skills">) as the numbered contents of a text
 * file, like `cat -n`. Underneath it's an outline: one h3 per category followed by a
 * list of its items. The "# " prefix, " · " separators and inter-item spaces are real
 * text (copied; prefix and separators aria-hidden); line numbers are CSS-generated, so they are never copied or read.
 */
import type { Locale } from "../i18n";
import { getEntries } from "../lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const categories = await getEntries("skills", locale);
// Each item is an unbreakable box ending in its separator, so "·" never starts a
// line; the space between items (outside the boxes) is the gap and the break point.
const separator = "\u00a0·";
---

<div class="file">
  {categories.map((category) => (
    <div class="file__group">
      <h3 class="file__line file__header">
        <span class="file__syntax" aria-hidden="true">
          #{" "}
        </span>
        {category.category}
      </h3>
      <ul class="file__line file__items" role="list">
        {category.items.map((item, i) => (
          <Fragment>
            {i > 0 && " "}
            <li>
              {item}
              {i < category.items.length - 1 && (
                <span class="file__syntax" aria-hidden="true">
                  {separator}
                </span>
              )}
            </li>
          </Fragment>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  /*
   * `cat -n` look. Widths are em-based (IBM Plex Mono advances 0.6em per glyph):
   * the gutter holds 2 right-aligned digits (1.2em) plus spacing, and every line
   * shares one line-height so numbers sit on their line's first visual row.
   */
  .file {
    --digits: 1.2em;
    --gutter: 3em;

    margin-top: var(--space-4);
    padding-left: var(--gutter);
    font-size: 0.9375rem;
    line-height: 1.7;
    counter-reset: line;
  }

  @media (max-width: 39.99rem) {
    .file {
      --gutter: 2.4em;
    }
  }

  .file__line {
    position: relative;
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    color: var(--text);
    counter-increment: line;
  }

  /* Regular weight and body size on purpose: a file line, not a display heading. */
  .file__header {
    font-family: var(--font-body);
    font-size: inherit;
    font-weight: 400;
    line-height: inherit;
  }

  /*
   * Items wrap as whole units: an inline-block moves to the next line intact, and
   * breaks internally only when it alone is wider than the column (max-width).
   * `vertical-align: top` keeps every row one line-height tall for the gutter.
   */
  .file__items li {
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
  }

  .file__syntax {
    color: var(--text-muted);
  }

  /*
   * Line numbers: generated content with empty alt text, so they are never copied,
   * selected or read. Browsers without alt-text support drop the declaration and
   * show no numbers, which is safe.
   */
  .file__line::before {
    content: counter(line) / "";
    position: absolute;
    top: 0;
    left: calc(-1 * var(--gutter));
    width: var(--digits);
    color: var(--text-dim);
    text-align: right;
  }

  /* Blank numbered line between categories: the ::after is itself the number. */
  .file__group:not(:last-child)::after {
    content: counter(line) / "";
    display: block;
    width: var(--digits);
    margin-left: calc(-1 * var(--gutter));
    color: var(--text-dim);
    text-align: right;
    counter-increment: line;
  }
</style>

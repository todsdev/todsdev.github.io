---
/**
 * Skills (rendered inside <Section id="skills">) as the numbered contents of a text
 * file, like `cat -n`. Underneath it's an outline: one h3 per category followed by a
 * list of its items. The "# " prefix and " · " separators are real text (copied, but
 * aria-hidden); line numbers are CSS-generated, so they are never copied or read.
 */
import type { Locale } from "../i18n";
import { getEntries } from "../lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const categories = await getEntries("skills", locale);
// The no-break space keeps each "·" on the line of the item before it.
const separator = " · ";
---

<div class="file">
  {categories.map((category) => (
    <div class="file__group">
      <h3 class="file__line file__header">
        <span class="file__syntax" aria-hidden="true">
          #{" "}
        </span>
        {category.category}
      </h3>
      <ul class="file__line file__items" role="list">
        {category.items.map((item, i) => (
          <li>
            {item}
            {i < category.items.length - 1 && (
              <span class="file__syntax" aria-hidden="true">
                {separator}
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

---
/**
 * Contact section (rendered inside <Section id="contact">): one terminal-style line per
 * contact — label · value · actions — plus the vCard and résumé downloads. Everything comes
 * from the contacts/profile collections and the dictionaries.
 *
 * Phone protection: protected kinds (phone, whatsapp; src/lib/contact.ts) never put their
 * value or url in the HTML. Their lines carry only an encoded form (data-enc-*); the inline
 * script right after the list decodes them before the rest of the page is parsed, so the
 * filled-in state is the one painted. Without JavaScript, CSS shows the "enable JavaScript"
 * note instead (the <html> class is "no-js" until BaseLayout's head script swaps it).
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import { localePath, t, type Locale } from "../i18n";
import {
  COMMANDS,
  actionsFor,
  encode,
  isProtected,
  type Destination,
} from "../lib/contact";
import { getEntries } from "../lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const contacts = await getEntries("contacts", locale);
const [profile] = await getEntries("profile", locale);
if (!profile) throw new Error("src/content/profile must contain one entry");
const name = profile.name;
const newTab = t(locale, "links.newTab");

/** Splits a destination template around {value}, filling {name}; protected values are filled at runtime. */
const parts = (
  dest: Destination | "vcard" | "resume",
  vars: Record<string, string> = {},
) => {
  const filled = Object.entries({ name, ...vars }).reduce(
    (s, [k, v]) => s.replaceAll(`{${k}}`, v),
    t(locale, `contact.destination.${dest}`),
  );
  const [before = "", after = ""] = filled.split("{value}");
  return { before, after, hasValue: filled.includes("{value}") };
};

// Résumé in the page's language, falling back to English when the file is missing.
const resumeLocale: Locale = existsSync(
  join(process.cwd(), "public", "resume", `resume-${locale}.pdf`),
)
  ? locale
  : "en";
const resumeHref = `/resume/resume-${resumeLocale}.pdf`;
const resumeName = parts("resume", {
  language: t(locale, `language.${resumeLocale}`),
}).before;
const vcardHref = `${localePath(locale)}contact.vcf`;
const vcardName = parts("vcard").before;
---

<ul class="contacts" role="list">
  {contacts.map((contact) => {
    const guarded = isProtected(contact.kind);
    const actions = actionsFor(contact.kind);
    return (
      <li
        class:list={["contact", { "contact--protected": guarded }]}
        data-kind={contact.kind}
        data-enc-value={guarded ? encode(contact.value) : undefined}
        data-enc-url={guarded ? encode(contact.url) : undefined}
        data-wa-text={
          contact.kind === "whatsapp"
            ? t(locale, "contact.whatsappText")
            : undefined
        }
      >
        <span class="contact__label">{contact.label}</span>
        <span class="contact__value">
          <span class="contact__sep" aria-hidden="true">
            {" · "}
          </span>
          {guarded ? <span data-fill="value" /> : contact.value}
        </span>
        {guarded && (
          <span class="contact__nojs">
            <span class="contact__sep" aria-hidden="true">
              {" · "}
            </span>
            {t(locale, "contact.noJs")}
          </span>
        )}
        <span class="contact__actions">
          <span class="contact__sep" aria-hidden="true">
            {" · "}
          </span>
          {actions.map((action, i) => {
            const label = parts(action.destination, {
              ...(guarded ? {} : { value: contact.value }),
            });
            const hidden = (
              <span class="visually-hidden">
                {`, ${label.before}`}
                {label.hasValue && <span data-fill="value" />}
                {label.after}
                {action.external && ` (${newTab})`}
              </span>
            );
            const control =
              action.type === "copy" ? (
                <button
                  type="button"
                  class="contact__action contact__copy"
                  data-copy={guarded ? undefined : contact.value}
                  data-copy-fill={guarded ? "" : undefined}
                >
                  <span class="contact__copy-idle">
                    <span aria-hidden="true">$ </span>
                    {action.command}
                    {hidden}
                  </span>
                  <span class="contact__copy-done" aria-hidden="true">
                    {t(locale, "contact.copied")}
                  </span>
                </button>
              ) : (
                <a
                  class="contact__action"
                  href={guarded ? undefined : contact.url}
                  data-fill-href={guarded ? "" : undefined}
                  target={action.external ? "_blank" : undefined}
                  rel={action.external ? "noopener" : undefined}
                >
                  <span aria-hidden="true">$ </span>
                  {action.command}
                  {hidden}
                </a>
              );
            // A real space between actions: readable as text and when copied.
            return (
              <Fragment>
                {i > 0 && " "}
                {control}
              </Fragment>
            );
          })}
        </span>
      </li>
    );
  })}
</ul>
<script is:inline>
  // Fills the protected lines before paint (mirrors decode() in src/lib/contact.ts:
  // base64 of the reversed string). The number never appears in the HTML.
  (function () {
    const dec = (s) => atob(s).split("").reverse().join("");
    for (const li of document.querySelectorAll("#contact [data-enc-value]")) {
      const value = dec(li.getAttribute("data-enc-value"));
      let url = dec(li.getAttribute("data-enc-url"));
      const text = li.getAttribute("data-wa-text");
      if (text) url += "?text=" + encodeURIComponent(text);
      for (const el of li.querySelectorAll("[data-fill=value]"))
        el.textContent = value;
      for (const a of li.querySelectorAll("[data-fill-href]"))
        a.setAttribute("href", url);
      for (const b of li.querySelectorAll("[data-copy-fill]"))
        b.setAttribute("data-copy", value);
    }
  })();
</script>
<ul class="contact__files" role="list">
  <li>
    {/* No whitespace between the command and its hidden destination: it would read "vcf ,". */}
    {/* prettier-ignore */}
    <a class="contact__action" href={vcardHref} download="contact.vcf" data-vcard><span aria-hidden="true">$ </span>{COMMANDS.vcard}<span class="visually-hidden">{`, ${vcardName}`}</span></a>
  </li>
  <li>
    {/* prettier-ignore */}
    <a class="contact__action" href={resumeHref} download="resume.pdf"><span aria-hidden="true">$ </span>{COMMANDS.resume}<span class="visually-hidden">{`, ${resumeName}`}</span></a>
  </li>
</ul>
<p class="visually-hidden" aria-live="polite" data-copy-status></p>

<script>
  import "../scripts/contact";
</script>

<style>
  /*
   * States (layout is below). Without JavaScript the protected lines show their note and
   * no value or actions, and copy buttons don't exist; with JavaScript the note is gone.
   * Both are decided by the <html> class before first paint, so nothing swaps later.
   */
  :global(.no-js) .contact--protected .contact__value,
  :global(.no-js) .contact--protected .contact__actions,
  :global(.no-js) .contact__copy {
    display: none;
  }

  :global(.js) .contact__nojs {
    display: none;
  }

  /* "$ copy" and its feedback share one cell, so the button is always as wide as the longer one. */
  .contact__copy {
    display: inline-grid;
  }

  .contact__copy-idle,
  .contact__copy-done {
    grid-area: 1 / 1;
  }

  .contact__copy-done,
  .contact__copy[data-copied] .contact__copy-idle {
    visibility: hidden;
  }

  .contact__copy[data-copied] .contact__copy-done {
    visibility: visible;
  }
</style>
